        // metatype that went in
        const auto map = value.toMap();
        if (map.isEmpty()) {
            // a bare number is the value on its own, switch untouched
            next.value = value.toInt();
            return next;
        }
        if (map.contains(QStringLiteral("active")))
            next.active = map.value(QStringLiteral("active")).toBool();
        if (map.contains(QStringLiteral("value")))
            next.value = map.value(QStringLiteral("value")).toInt();
        return next;
    }
{% endif %}
