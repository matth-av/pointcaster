{# ============================================================================
   Shared base for generated Qt config/device adapters.

   This is the base template. device_adapter_impl.h.j2 {% extends %} it and
   overrides only the blocks that differ:

     extra_includes        - child-specific #includes
     base_class            - the C++ base class (ConfigAdapter / DeviceAdapter)
     aliases               - extra public type aliases (device only)
     ctor_params           - constructor parameter list
     ctor_base_init        - base-class mem-initialiser
     set_config_*          - the setConfig overloads
     trait_specializations - trailing template emitted after the class loop

   Blocks that reference the per-struct loop variable `s` are declared `scoped`.
   ============================================================================ #}
{# ---- helper that packs a Toggleable of this kind into a QVariantMap ---- #}
{% macro toggleable_to_map(kind) %}
{%- if kind == "toggleable_bounds" %}toggleableBoundsToMap
{%- elif kind == "toggleable_int" %}toggleableIntToMap
{%- elif kind == "toggleable_float" %}toggleableFloatToMap
{%- else %}toggleableRadiusToMap
{%- endif %}
{%- endmacro %}
{# ---- reading a member into a QVariant ---- #}
{% macro value_case(m) %}
        if (path == QStringLiteral("{{ m.path }}")) {
{% if m.alternative %}
            const auto *alt = rfl::get_if<{{ m.alternative.cpp_type }}>(&{{ m.alternative.variant_ref }});
            if (!alt) return {};
{% endif %}
{% if m.kind == "string" and m.cpp_type == "std::string" %}
            return QVariant(QString::fromStdString({{ m.read }}));
{% elif m.kind == "string" %}
            return QVariant({{ m.read }});
{% elif m.kind == "enum" %}
            return QVariant(static_cast<int>({{ m.read }}));
{% elif m.kind == "variant" %}
            return QVariant(static_cast<int>({{ m.read }}{{ m.variant_access }}.index()));
{% elif m.kind == "float3" %}
            const auto &v = {{ m.read }};
            return QVariant::fromValue(QVector3D(v.x, v.y, v.z));
{% elif m.kind == "quaternion" %}
            const auto &v = {{ m.read }};
            return QVariant::fromValue(QQuaternion(v.scalar, v.x, v.y, v.z));
{% elif m.kind == "position" %}
            return QVariant::fromValue(positionToMetres({{ m.read }}));
{% elif m.kind == "length" or m.kind == "radius" %}
            return QVariant(double({{ m.read }}.metres()));
{% elif m.kind == "position_bounds" %}
            return boundsToMetresMap({{ m.read }});
{% elif m.kind == "toggleable_bounds" %}
            return toggleableBoundsToMap({{ m.read }});
{% elif m.kind == "toggleable_radius" %}
            return toggleableRadiusToMap({{ m.read }});
{% elif m.kind == "toggleable_int" %}
            return toggleableIntToMap({{ m.read }});
{% elif m.kind == "toggleable_float" %}
            return toggleableFloatToMap({{ m.read }});
{% elif m.kind == "stream" %}
            const auto stream = {{ m.read }};
            return QVariant(stream ? int(stream->size()) : -1);
{% else %}
            return QVariant::fromValue({{ m.read }});
{% endif %}
        }
{%- endmacro %}
{# ---- converting an incoming QVariant and writing it back ---- #}
{% macro apply_case(m) %}
        if (path == QStringLiteral("{{ m.path }}")) {
{% if m.alternative %}
            auto *alt = rfl::get_if<{{ m.alternative.cpp_type }}>(&{{ m.alternative.variant_ref }});
            if (!alt) return false;
{% endif %}
{% if m.kind == "string" and m.cpp_type == "std::string" %}
            const std::string newValue = value.toString().toStdString();
{% elif m.kind == "string" %}
            const QString newValue = value.toString();
{% elif m.kind == "bool" %}
            const bool newValue = value.toBool();
{% elif m.kind == "int" and m.cpp_type == "int" %}
            const int newValue = value.toInt();
{% elif m.kind == "int" %}
            const {{ m.cpp_type }} newValue = static_cast<{{ m.cpp_type }}>(value.toInt());
{% elif m.kind == "float" and m.cpp_type == "float" %}
            const float newValue = value.toFloat();
{% elif m.kind == "float" %}
            const {{ m.cpp_type }} newValue = value.toDouble();
{% elif m.kind == "enum" %}
            const auto newValue = static_cast<{{ m.enum_qualified_type }}>(value.toInt());
{% elif m.kind == "float3" %}
            const QVector3D v = toQVector3DLoose(value);
            const {{ m.cpp_type }} newValue{ v.x(), v.y(), v.z() };
{% elif m.kind == "quaternion" %}
            const QQuaternion v = toQQuaternionLoose(value);
            const {{ m.cpp_type }} newValue{ v.scalar(), v.x(), v.y(), v.z() };
{% elif m.kind == "position" %}
            const pc::position newValue = positionFromMetres(toQVector3DLoose(value));
{% elif m.kind == "length" %}
            const pc::length newValue = pc::length::from_metres(value.toFloat());
{% elif m.kind == "radius" %}
            const pc::radius newValue = pc::radius::from_metres(value.toFloat());
{#- a write naming only some of a toggleable's parts leaves the rest alone, so
    the gizmo can move the value without touching the switch, and the switch
    can flick without disturbing the value the user dialled in -#}
{% elif m.kind == "toggleable_bounds" %}
            const auto newValue = toggleableBoundsLoose(value, {{ m.read }});
{% elif m.kind == "toggleable_radius" %}
            const auto newValue = toggleableRadiusLoose(value, {{ m.read }});
{% elif m.kind == "toggleable_int" %}
            const auto newValue = toggleableIntLoose(value, {{ m.read }});
{% elif m.kind == "toggleable_float" %}
            const auto newValue = toggleableFloatLoose(value, {{ m.read }});
{% elif m.kind == "position_bounds" %}
            const pc::position_bounds newValue = toPositionBoundsLoose(value);
{% else %}
            const auto newValue = qvariant_cast<{{ m.cpp_type }}>(value);
{% endif %}
{% if m.comparable %}
            if ({{ m.read }} == newValue)
                return false;
{% endif %}
{% if m.is_rfl %}
            {{ m.ref }}.set(newValue);
{% else %}
            {{ m.ref }} = newValue;
{% endif %}
{% if m.is_own %}
            emit {{ m.name }}Changed();
{% endif %}
            notifyFieldChanged(QStringLiteral("{{ m.path }}"));
            return true;
        }
{%- endmacro %}
{# ---- forwarding a path below a nested configuration to its adapter ---- #}
{% macro forward_case(m, method, extra) %}
        if (path.startsWith(QStringLiteral("{{ m.path }}/"))) {
            const QString sub = path.mid(int(QStringLiteral("{{ m.path }}/").size()));
            return m_{{ m.name }}Adapter.{{ method }}(sub{{ extra }});
        }
{%- endmacro %}
{# ---- a member's default, as a QVariant ---- #}
{% macro default_variant(m) %}
{% if m.kind == "variant" %}
QVariant({{ m.variant_default_index }})
{%- elif m.kind == "enum" %}
QVariant({{ m.enum_default if m.enum_default is not none else 0 }})
{%- elif m.kind == "float3" %}
QVariant::fromValue(QVector3D({{ (m.default_components or [0.0, 0.0, 0.0]) | join('f, ') }}f))
{%- elif m.kind == "quaternion" %}
QVariant::fromValue(QQuaternion({{ (m.default_components or [1.0, 0.0, 0.0, 0.0]) | join('f, ') }}f))
{%- elif m.kind == "length" or m.kind == "radius" %}
QVariant({{ (m.default_value or 0) / 1000 }})
{%- elif m.is_toggleable %}
{% if m.default_expr %}QVariant({{ toggleable_to_map(m.kind) }}({{ m.default_expr }})){% else %}QVariant(){% endif %}
{%- elif m.kind == "position_bounds" %}
{% if m.default_expr %}QVariant(boundsToMetresMap({{ m.default_expr }})){% else %}QVariant(){% endif %}
{%- elif m.kind == "stream" %}
QVariant()
{%- elif m.default_value is none %}
QVariant()
{%- elif m.default_value is boolean %}
QVariant({{ "true" if m.default_value else "false" }})
{%- elif m.default_value is number %}
QVariant({{ m.default_value }})
{%- else %}
QVariant(QStringLiteral("{{ m.default_value }}"))
{%- endif %}
{% endmacro %}
#pragma once

// !! Generated adapter !!

#include <QObject>
#include <QVariant>
#include <QVariantMap>
#include <QString>
#include <QStringList>
#include <QMetaType>
#include <QMap>
#include <QSet>
{% if needs_qvector3d -%}
#include <QVector3D>
{% endif -%}
{% if needs_qquaternion -%}
#include <QQuaternion>
{% endif -%}
#include <rfl/Variant.hpp>
#include <variant>

#include <ui/models/config_adapter.h>
{% block extra_includes %}
#include <config/config_variant.h>
#include <logger/logger.h>
{% endblock %}
#include <{{ header_include_path }}>

{% if structs|length > 0 %}
{# Include nested config adapter headers so we can embed adapters by value. #}
{% for s in structs %}
{% for inc in s.nested_adapter_includes %}
#include <{{ inc }}>
{% endfor %}
{% endfor %}

{% if namespace_name %}
namespace {{ namespace_name }} {

{% endif %}
{% for s in structs %}
class {{ s.adapter_name }} : public {% block base_class %}ConfigAdapter{% endblock %} {
    Q_OBJECT

{# ---- Per-field Q_PROPERTY generation ---- #}
{% for m in s.members if m.is_own %}
{% if m.kind == "nested" %}
    Q_PROPERTY(QObject* {{ m.name }}Adapter READ {{ m.name }}Adapter CONSTANT)
{% elif m.qt_type %}
    Q_PROPERTY({{ m.qt_type }} {{ m.name }} READ {{ m.name }} WRITE set_{{ m.name }} NOTIFY {{ m.name }}Changed)
{% endif %}
{% endfor %}

public:
{% block aliases scoped %}{% endblock %}
    explicit {{ s.adapter_name }}({% block ctor_params scoped %}{{ s.struct_name }} &config, QObject *parent = nullptr{% endblock %})
{% block ctor_base_init scoped %}        : ConfigAdapter(parent)
{% endblock %}        , m_config(config)
{% for m in s.members if m.kind == "nested" %}
        , m_{{ m.name }}Adapter({{ m.read }}, this)
{% endfor %}
    {
{% for m in s.members if m.kind == "nested" %}
        // Forward nested edit requests as stable prefixed paths: "{{ m.name }}/..."
        QObject::connect(&m_{{ m.name }}Adapter, &ConfigAdapter::editRequested, this,
            [this](const QString &subPath, const QVariant &value) {
                emit editRequested(QStringLiteral("{{ m.name }}/") + subPath, value);
            });

        // Forward nested change notifications too.
        QObject::connect(&m_{{ m.name }}Adapter, &ConfigAdapter::fieldChanged, this,
            [this](const QString &subPath) {
                notifyFieldChanged(QStringLiteral("{{ m.name }}/") + subPath);
            });

        // A nested variant switch changes which of our paths are visible.
        QObject::connect(&m_{{ m.name }}Adapter, &ConfigAdapter::structureChanged, this,
            [this]() { notifyStructureChanged(); });
{% endfor %}
    }

    QString configType() const override { return QStringLiteral("{{ s.struct_name }}"); }
    Q_INVOKABLE QString displayName() const override { return QStringLiteral("{{ s.label }}"); }

    const void *configStorage() const override { return &m_config; }

{% block set_config_variant_wrapper scoped %}
    // ---- Core-only ----
    bool setConfig(const pc::ConfigurationVariant &config) override {
        const auto *configPtr = std::get_if<{{ s.struct_name }}>(&config);
        if (!configPtr) return false;
        return setConfig(*configPtr);
    }
{% endblock %}

{% block set_config_typed scoped %}
    bool setConfig(const {{ s.struct_name }} &config) {
        bool anyChanged = false;

{% for m in s.members if m.is_own %}
{% if m.is_output %}
{# ignore outputs #}
{% elif m.kind == "nested" %}
{# nested members are handled by the push-down at the end of this function #}
{% elif m.kind == "variant" %}
        // a different alternative replaces the whole value; the same
        // alternative is diffed field by field below
        if ({{ m.read }}{{ m.variant_access }}.index() != config.{{ m.name }}{% if m.is_rfl %}.value(){% endif %}{{ m.variant_access }}.index()) {
            {{ m.ref }} = config.{{ m.name }};
            anyChanged = true;
            emit {{ m.name }}Changed();
            notifyStructureChanged();
            notifyFieldChanged(QStringLiteral("{{ m.path }}"));
        }
{% elif m.comparable %}
        if (!({{ m.read }} == config.{{ m.name }}{% if m.is_rfl %}.value(){% endif %})) {
            anyChanged = true;
            {{ m.ref }} = config.{{ m.name }};
            emit {{ m.name }}Changed();
            notifyFieldChanged(QStringLiteral("{{ m.path }}"));
        }
{% else %}
        {{ m.ref }} = config.{{ m.name }};
        anyChanged = true;
        emit {{ m.name }}Changed();
        notifyFieldChanged(QStringLiteral("{{ m.path }}"));
{% endif %}
{% endfor %}
{% for v in s.variants %}
{% for alt in v.alternatives if alt.leaves %}

        if (auto *alt = rfl::get_if<{{ alt.cpp_type }}>(&{{ alt.variant_ref }})) {
            const auto *incoming = rfl::get_if<{{ alt.cpp_type }}>(
                &config.{{ v.name }}{% if v.is_rfl %}.value(){% endif %}{{ v.variant_access }});
            if (incoming) {
{% for m in alt.leaves %}
{% set source = "incoming->" + m.name + (".value()" if m.is_rfl else "") %}
{% if m.comparable %}
                if (!({{ m.read }} == {{ source }})) {
                    anyChanged = true;
{% if m.is_rfl %}
                    {{ m.ref }}.set({{ source }});
{% else %}
                    {{ m.ref }} = {{ source }};
{% endif %}
                    notifyFieldChanged(QStringLiteral("{{ m.path }}"));
                }
{% else %}
{% if m.is_rfl %}
                {{ m.ref }}.set({{ source }});
{% else %}
                {{ m.ref }} = {{ source }};
{% endif %}
                anyChanged = true;
                notifyFieldChanged(QStringLiteral("{{ m.path }}"));
{% endif %}
{% endfor %}
            }
        }
{% endfor %}
{% endfor %}

{% for m in s.members if m.kind == "nested" %}
        if (m_{{ m.name }}Adapter.setConfig(config.{{ m.name }}{% if m.is_rfl %}.value(){% endif %})) {
            anyChanged = true;
            emit {{ m.name }}Changed();
        }
{% endfor %}
        return anyChanged;
    }
{% endblock %}

    // ---- Enumerate stable paths ----
    Q_INVOKABLE QStringList fieldPaths() const override {
        static const QStringList kPaths = {
{% for p in s.paths %}
            QStringLiteral("{{ p }}"){{ "," if not loop.last else "" }}
{% endfor %}
        };
        return kPaths;
    }


    Q_INVOKABLE QList<QStringList> childPaths() const override {
        static const QList<QStringList> paths {
{% for group in s.groups %}
            {
{% for path in group.paths %}
                QStringLiteral("{{ path }}"){{ "," if not loop.last else "" }}
{% endfor %}
            },
{% endfor %}
        };
        return paths;
    }

    Q_INVOKABLE QString parentConfigurationName(const QString &path) const override {
        static const QMap<QString, QString> parentConfigurationNames {
{% for path, name in s.parent_names.items() %}
            { QStringLiteral("{{ path }}"), QStringLiteral("{{ name }}") }{{ "," if not loop.last else "" }}
{% endfor %}
        };
        return parentConfigurationNames.value(path);
    }

    Q_INVOKABLE QStringList radiusPaths() const override {
        QStringList paths;
{% for m in s.members %}
{% if m.kind == "nested" %}
        for (const QString &sub : m_{{ m.name }}Adapter.radiusPaths())
            paths.append(QStringLiteral("{{ m.path }}/") + sub);
{% elif m.kind == "radius" or m.kind == "toggleable_radius" %}
        if (!isHidden(QStringLiteral("{{ m.path }}")))
            paths.append(QStringLiteral("{{ m.path }}"));
{% endif %}
{% endfor %}
        return paths;
    }

    Q_INVOKABLE bool isFoldedByDefault(const QString &path) const override {
{% if s.folded_paths %}
        static const QSet<QString> foldedPaths {
{% for path in s.folded_paths %}
            QStringLiteral("{{ path }}"){{ "," if not loop.last else "" }}
{% endfor %}
        };
        return foldedPaths.contains(path);
{% else %}
        Q_UNUSED(path);
        return false;
{% endif %}
    }

{# ---- Per-field strongly-typed accessors ---- #}
{% for m in s.members if m.is_own %}
{% if m.kind == "nested" %}
    Q_INVOKABLE QObject* {{ m.name }}Adapter() { return &m_{{ m.name }}Adapter; }
{% elif m.kind == "variant" %}
    Q_INVOKABLE int {{ m.name }}() const { return static_cast<int>({{ m.read }}{{ m.variant_access }}.index()); }
    Q_INVOKABLE void set_{{ m.name }}(int value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant(value)); }
{% elif m.kind == "enum" %}
    Q_INVOKABLE int {{ m.name }}() const { return static_cast<int>({{ m.read }}); }
    Q_INVOKABLE void set_{{ m.name }}(int value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant(value)); }
{% elif m.kind == "string" %}
{% if m.cpp_type == "std::string" %}
    Q_INVOKABLE QString {{ m.name }}() const { return QString::fromStdString({{ m.read }}); }
{% else %}
    Q_INVOKABLE QString {{ m.name }}() const { return {{ m.read }}; }
{% endif %}
    Q_INVOKABLE void set_{{ m.name }}(const QString &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant(value)); }
{% elif m.kind == "float3" %}
    Q_INVOKABLE QVector3D {{ m.name }}() const {
        const auto &v = {{ m.read }};
        return QVector3D(v.x, v.y, v.z);
    }
    Q_INVOKABLE void set_{{ m.name }}(const QVector3D &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
    Q_INVOKABLE void set_{{ m.name }}(float x, float y, float z) {
        emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(QVector3D(x, y, z)));
    }
{% elif m.kind == "quaternion" %}
    Q_INVOKABLE QQuaternion {{ m.name }}() const {
        const auto &v = {{ m.read }};
        return QQuaternion(v.scalar, v.x, v.y, v.z);
    }
    Q_INVOKABLE void set_{{ m.name }}(const QQuaternion &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
    Q_INVOKABLE void set_{{ m.name }}(float scalar, float x, float y, float z) {
        emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(QQuaternion(scalar, x, y, z)));
    }
{% elif m.kind == "position" %}
    Q_INVOKABLE QVector3D {{ m.name }}() const { return positionToMetres({{ m.read }}); }
    Q_INVOKABLE void set_{{ m.name }}(const QVector3D &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
    Q_INVOKABLE void set_{{ m.name }}(float x, float y, float z) {
        emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(QVector3D(x, y, z)));
    }
{% elif m.kind == "position_bounds" %}
    Q_INVOKABLE QVariantMap {{ m.name }}() const { return boundsToMetresMap({{ m.read }}); }
    Q_INVOKABLE void set_{{ m.name }}(const QVariantMap &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
{% elif m.kind == "length" or m.kind == "radius" %}
    Q_INVOKABLE double {{ m.name }}() const { return {{ m.read }}.metres(); }
    Q_INVOKABLE void set_{{ m.name }}(double value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant(value)); }
{% elif m.is_toggleable %}
    Q_INVOKABLE QVariantMap {{ m.name }}() const { return {{ toggleable_to_map(m.kind) }}({{ m.read }}); }
    Q_INVOKABLE void set_{{ m.name }}(const QVariantMap &value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
    Q_INVOKABLE void set_{{ m.name }}_active(bool active) {
        QVariantMap payload;
        payload.insert(QStringLiteral("active"), active);
        emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(payload));
    }
{% elif m.qt_type %}
    Q_INVOKABLE {{ m.qt_type }} {{ m.name }}() const { return {{ m.read }}; }
    Q_INVOKABLE void set_{{ m.name }}({{ m.qt_type }} value) { emit editRequested(QStringLiteral("{{ m.path }}"), QVariant::fromValue(value)); }
{% endif %}
{% endfor %}

    // ---- Re-announce every property ----
    void notifyAllPropertiesChanged() override {
{% for m in s.members if m.is_own %}
        emit {{ m.name }}Changed();
{% endfor %}
    }

signals:
{% for m in s.members if m.is_own %}
    void {{ m.name }}Changed();
{% endfor %}

{#- Which private conversion helpers this struct needs... -#}

{% set kinds = s.members | map(attribute="kind") | list %}
{% set want_bounds = "position_bounds" in kinds or "toggleable_bounds" in kinds %}
{% set want_position = "position" in kinds or want_bounds %}
{% set want_vector3d = want_position or "float3" in kinds %}
{% set want_quaternion = "quaternion" in kinds %}
{% set want_toggleable_radius = "toggleable_radius" in kinds %}
{% set want_toggleable_int = "toggleable_int" in kinds %}
{% set want_toggleable_float = "toggleable_float" in kinds %}
{% if want_vector3d or want_quaternion or want_toggleable_radius or want_toggleable_int or want_toggleable_float %}
private:
{% endif %}
{% if want_vector3d %}
    static QVector3D toQVector3DLoose(const QVariant &value) {
        if (value.canConvert<QVector3D>())
            return value.value<QVector3D>();
        if (value.metaType().id() == QMetaType::QVariantMap) {
            const auto m = value.toMap();
            return QVector3D(
                m.value(QStringLiteral("x")).toFloat(),
                m.value(QStringLiteral("y")).toFloat(),
                m.value(QStringLiteral("z")).toFloat());
        }
        if (value.metaType().id() == QMetaType::QVariantList) {
            const auto l = value.toList();
            if (l.size() >= 3)
                return QVector3D(l[0].toFloat(), l[1].toFloat(), l[2].toFloat());
        }
        return QVector3D();
    }
{% endif %}
{% if want_quaternion %}
    static QQuaternion toQQuaternionLoose(const QVariant &value) {
        if (value.canConvert<QQuaternion>())
            return value.value<QQuaternion>();
        if (value.metaType().id() == QMetaType::QVariantMap) {
            const auto m = value.toMap();
            return QQuaternion(
                m.value(QStringLiteral("scalar")).toFloat(),
                m.value(QStringLiteral("x")).toFloat(),
                m.value(QStringLiteral("y")).toFloat(),
                m.value(QStringLiteral("z")).toFloat());
        }
        if (value.metaType().id() == QMetaType::QVariantList) {
            const auto l = value.toList();
            if (l.size() >= 4)
                return QQuaternion(l[0].toFloat(), l[1].toFloat(), l[2].toFloat(), l[3].toFloat());
        }
        return QQuaternion();
    }
{% endif %}
{% if want_position %}
    // internal position types are int16 millimetres, and QML works in metres
    // throughout -- pc::length carries the conversion and its clamping
    static QVector3D positionToMetres(const pc::position &p) {
        return QVector3D(pc::length{p.x}.metres(), pc::length{p.y}.metres(),
                         pc::length{p.z}.metres());
    }

    static pc::position positionFromMetres(const QVector3D &v) {
        return pc::position{pc::length::from_metres(v.x()).mm,
                            pc::length::from_metres(v.y()).mm,
                            pc::length::from_metres(v.z()).mm};
    }

    static QVariantMap boundsToMetresMap(const pc::position_bounds &bounds) {
        QVariantMap map;
        map.insert(QStringLiteral("min"), QVariant::fromValue(positionToMetres(bounds.min)));
        map.insert(QStringLiteral("max"), QVariant::fromValue(positionToMetres(bounds.max)));
        return map;
    }

    static pc::position_bounds toPositionBoundsLoose(const QVariant &value) {
        const auto map = value.toMap();
        return pc::position_bounds{
            positionFromMetres(toQVector3DLoose(map.value(QStringLiteral("min")))),
            positionFromMetres(toQVector3DLoose(map.value(QStringLiteral("max"))))};
    }
{% endif %}
{% if "toggleable_bounds" in kinds %}
    static QVariantMap toggleableBoundsToMap(const pc::Toggleable<pc::position_bounds> &bounds) {
        QVariantMap map = boundsToMetresMap(bounds.value);
        map.insert(QStringLiteral("active"), bounds.active);
        return map;
    }

    static pc::Toggleable<pc::position_bounds>
    toggleableBoundsLoose(const QVariant &value,
                          const pc::Toggleable<pc::position_bounds> &current) {
        const auto map = value.toMap();
        auto next = current;
        if (map.contains(QStringLiteral("active")))
            next.active = map.value(QStringLiteral("active")).toBool();
        if (map.contains(QStringLiteral("min")))
            next.value.min = positionFromMetres(toQVector3DLoose(map.value(QStringLiteral("min"))));
        if (map.contains(QStringLiteral("max")))
            next.value.max = positionFromMetres(toQVector3DLoose(map.value(QStringLiteral("max"))));
        return next;
    }
{% endif %}
{% if want_toggleable_radius %}
    static QVariantMap toggleableRadiusToMap(const pc::Toggleable<pc::radius> &r) {
        QVariantMap map;
        map.insert(QStringLiteral("active"), r.active);
        map.insert(QStringLiteral("value"), double(r.value.metres()));
        return map;
    }

    static pc::Toggleable<pc::radius>
    toggleableRadiusLoose(const QVariant &value,
                          const pc::Toggleable<pc::radius> &current) {
        auto next = current;
        // an object written from QML does not arrive as a QVariantMap, it
        // arrives as something toMap() knows how to open, so the shape is read
        // off what came out rather than off the metatype that went in
        const auto map = value.toMap();
        if (map.isEmpty()) {
            // a bare number is the distance on its own, switch untouched
            next.value = pc::radius::from_metres(value.toFloat());
            return next;
        }
        if (map.contains(QStringLiteral("active")))
            next.active = map.value(QStringLiteral("active")).toBool();
        if (map.contains(QStringLiteral("value")))
            next.value = pc::radius::from_metres(map.value(QStringLiteral("value")).toFloat());
        return next;
    }
{% endif %}
