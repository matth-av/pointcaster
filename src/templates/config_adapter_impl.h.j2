public:
    // ---- Path-based reads ----
    Q_INVOKABLE QVariant value(const QString &path) const override {
{% for m in s.members %}
{% if m.kind == "nested" %}
        if (path == QStringLiteral("{{ m.path }}"))
            return QVariant(); // whole-struct-by-value not exposed
{{ forward_case(m, "value", "") }}
{% else %}
{{ value_case(m) }}
{% endif %}
{% endfor %}
        return {};
    }

    // ---- Path-based apply (mutates config) ----
    Q_INVOKABLE bool apply(const QString &path, const QVariant &value) override {
{% for m in s.members %}
{% if m.is_output %}
{# read-only: only the plugin writes it #}
{% elif m.kind == "nested" %}
{{ forward_case(m, "apply", ", value") }}
{% elif m.kind == "variant" %}
        // switching alternative replaces the held value with a
        // default-constructed one of the requested type
        if (path == QStringLiteral("{{ m.path }}")) {
            auto &variant = {{ m.read }}{{ m.variant_access }};
            const int newIndex = value.toInt();
            if (newIndex == variant.index()) return false;
            switch (newIndex) {
{% for alt in m.alternatives %}
            case {{ alt.index }}: variant = {{ alt.cpp_type }}{}; break;
{% endfor %}
            default: return false;
            }
            emit {{ m.name }}Changed();
            notifyStructureChanged();
            notifyFieldChanged(QStringLiteral("{{ m.path }}"));
            return true;
        }
{% else %}
{{ apply_case(m) }}
{% endif %}
{% endfor %}
        return false;
    }

    // ---- Metadata by path ----
    Q_INVOKABLE QString typeName(const QString &path) const override {
{% for m in s.members %}
{% if m.kind == "nested" %}
{{ forward_case(m, "typeName", "") }}
{% else %}
        if (path == QStringLiteral("{{ m.path }}"))
{# a tagged union's discriminator is quoted, so it needs escaping in here #}
            return QStringLiteral("{{ m.cpp_type | replace('"', '\\"') }}");
{% endif %}
{% endfor %}
        return {};
    }

