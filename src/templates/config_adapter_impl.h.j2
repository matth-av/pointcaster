{% for m in s.members %}
{% if m.kind == "nested" %}
{{ forward_case(m, "minMax", "") }}
{% elif m.min_max and (m.kind in ("length", "radius", "toggleable_radius")) %}
{#- a distance's bounds are written in millimetres, like the member itself #}
