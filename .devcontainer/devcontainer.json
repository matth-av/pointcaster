{
  "name": "pointcaster-qt",
  "image": "cr.pointcaster.net/pointcaster-dev:latest-linux",
  "initializeCommand": "touch ${localWorkspaceFolder}/.env",
  "runArgs": [
    "--platform",
    "linux/amd64",
    "--env-file",
    "${localWorkspaceFolder}/.env"
  ],
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/pointcaster",
  "workspaceMount": "source=${localWorkspaceFolder},target=/pointcaster,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "delgan.qml-format",
        "ms-python.python"
      ]
    },
    "qt-creator": {
      "device": {
        "auto-detect-kits": true,
        "copy-cmd-bridge": true,
        "mount-libexec": false
      }
    }
  }
}